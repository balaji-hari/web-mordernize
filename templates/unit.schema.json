{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/balaji-hari/web-mordernize/templates/unit.schema.json",
  "title": "web-modernize migration unit",
  "description": "Schema for .claude/modernize/units/<unit-id>.json — one file per migration unit. Lifted from v2's state.schema.json $defs/unit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "source_paths", "depends_on", "status"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable identifier (e.g., LoginController, OrderListPage). Used in /web-modernize:migrate <id>, the file name, and notes_path."
    },
    "kind": {
      "enum": ["page", "controller", "component", "module", "service", "endpoint", "shared"]
    },
    "source_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "target_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "depends_on": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Other unit ids (or __auth__) that must be migrated first."
    },
    "phase": { "type": "integer", "minimum": 1 },
    "effort": { "enum": ["S", "M", "L", "XL"] },
    "status": {
      "enum": ["pending", "in_progress", "migrated", "verified", "blocked", "skipped", "failed"]
    },
    "history": {
      "type": "array",
      "items": { "$ref": "#/$defs/history_entry" }
    },
    "in_flight": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/in_flight" }
      ]
    },
    "notes_path": { "type": "string" },
    "verification": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "lint": { "type": "string" },
        "typecheck": { "type": "string" },
        "tests": { "type": "string" },
        "verified_at": { "type": "string", "format": "date-time" }
      }
    },
    "failure": {
      "type": "object",
      "properties": {
        "diagnostic": { "type": "string" },
        "branch": { "type": "string" },
        "diagnostic_history": {
          "type": "array",
          "description": "Append-only log of every failure diagnostic this unit has seen. Each /retry pushes the current diagnostic here before overwriting failure.diagnostic with the new one.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "diagnostic"],
            "properties": {
              "at": { "type": "string", "format": "date-time" },
              "diagnostic": { "type": "string" },
              "retry_count": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of times this unit has been retried after a previous failure. Bumped by /web-modernize:retry."
    },
    "last_retry_prompt": {
      "oneOf": [
        { "type": "null" },
        { "type": "string" }
      ],
      "description": "The most recent --with-prompt override passed to /web-modernize:retry, or null if never retried with a prompt."
    },
    "rollback_info": {
      "description": "Populated by /web-modernize:rollback when a unit is rolled back. Null if never rolled back.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["at", "by"],
          "properties": {
            "at": { "type": "string", "format": "date-time" },
            "by": { "type": "string" },
            "branch": { "type": "string", "description": "The feature branch that was reset/removed, if any." },
            "restored_paths": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Target files that were reverted (deleted, or restored to pre-migration state)."
            },
            "reason": { "type": "string" }
          }
        }
      ]
    },
    "tests": {
      "description": "Populated by the unit-migrator's step 7c (translate-or-generate) when state.testing has a real framework. Tracks which legacy tests were translated, which were skipped/untranslatable, how many were generated to top up to target coverage, and the final coverage measurement. Omitted (or carries skipped_reason) when the team chose a manual / n/a runner at /scaffold time.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "framework": {
          "type": "string",
          "description": "Mirrors the relevant entry of state.testing (vitest, pytest, junit5, xunit, jest, karma-jasmine, manual, n/a, etc.)."
        },
        "skipped_reason": {
          "type": "string",
          "description": "Present when framework is 'manual' or 'n/a' — explains why 7c was a no-op."
        },
        "translated_from": {
          "type": "array",
          "description": "Legacy test files successfully ported to the target framework.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["legacy_path", "target_path"],
            "properties": {
              "legacy_path": { "type": "string" },
              "target_path": { "type": "string" },
              "tests_in_file": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "translated_count": { "type": "integer", "minimum": 0 },
        "skipped_legacy": {
          "type": "array",
          "description": "Legacy tests marked disabled (Ignore, Disabled, xit, pytest.mark.skip, etc.) — recorded but not ported.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "untranslatable": {
          "type": "array",
          "description": "Legacy tests that could not be ported (no target equivalent for the legacy infrastructure they depend on).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["legacy_path", "reason"],
            "properties": {
              "legacy_path": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "generated_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Tests written by 7c to top up to target_pct. Capped at 2 generation passes."
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pct", "target_pct", "below_threshold"],
          "properties": {
            "pct": { "type": "integer", "minimum": 0, "maximum": 100 },
            "target_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
            "below_threshold": { "type": "boolean" },
            "uncovered_regions": {
              "type": "array",
              "description": "Present when below_threshold is true. Each entry is one branch/region that 7c could not cover after 2 generation passes.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["file", "line_range"],
                "properties": {
                  "file": { "type": "string" },
                  "line_range": { "type": "string", "description": "e.g., '42-58'" },
                  "branch_description": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "by", "from", "to"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "by": { "type": "string", "description": "User identity (email when available)." },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "session_id": { "type": "string" }
      }
    },
    "in_flight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "by", "last_heartbeat"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "by": { "type": "string" },
        "host": { "type": "string" },
        "session_id": { "type": "string" },
        "last_heartbeat": { "type": "string", "format": "date-time" },
        "current_step": { "type": "string" },
        "files_touched_so_far": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
