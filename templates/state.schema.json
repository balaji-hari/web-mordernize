{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/balaji-hari/web-mordernize/templates/state.schema.json",
  "title": "web-modernize migration state",
  "description": "Schema for .claude/modernize/state.json — the git-tracked progress ledger maintained by the web-modernize plugin.",
  "type": "object",
  "required": ["schema_version", "plugin_version", "status", "units"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "description": "Increment when the schema shape changes; /init can migrate forward.",
      "const": 2
    },
    "plugin_version": {
      "description": "Version of the web-modernize plugin that last wrote this file.",
      "type": "string"
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remote": { "type": "string" },
        "root_commit": { "type": "string" }
      }
    },
    "status": {
      "description": "Top-level workflow phase. Drives which skill is eligible to run next.",
      "enum": [
        "uninitialized",
        "initialized",
        "analyzed",
        "planned",
        "scaffolded",
        "auth_done",
        "in_progress",
        "complete"
      ]
    },
    "source_stack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "detected_at": { "type": "string", "format": "date-time" },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "confidence": { "type": "number" }
            }
          }
        }
      }
    },
    "target_stack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui": { "type": "string", "description": "e.g. react-vite-ts, next-app-router, vue3-vite, angular-17, svelte-kit" },
        "api": { "type": "string", "description": "e.g. dotnet-minimal-api, spring-boot-3, nestjs, fastapi, reuse-existing, none" },
        "db": { "type": "string", "description": "e.g. unchanged, schema-migrate-to-postgres, replatform-to-mongodb" }
      }
    },
    "strategy": {
      "enum": ["strangler-fig", "big-bang", "module-by-module"]
    },
    "scaffold": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui": { "$ref": "#/$defs/subsystem" },
        "api": { "$ref": "#/$defs/subsystem" },
        "db": { "$ref": "#/$defs/subsystem" }
      }
    },
    "units": {
      "type": "array",
      "items": { "$ref": "#/$defs/unit" }
    },
    "out_of_scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lock": {
      "description": "Advisory lock for full-repo operations (plan, scaffold). null when no lock held.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["holder", "session_id", "expires_at"],
          "additionalProperties": false,
          "properties": {
            "holder": { "type": "string" },
            "session_id": { "type": "string" },
            "expires_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "subsystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["pending", "in_progress", "done", "skipped", "failed"] },
        "path": { "type": "string" },
        "reason": { "type": "string", "description": "Required when status == skipped." },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "completed_by": { "type": "string" }
      },
      "required": ["status"]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source_paths", "depends_on", "status"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable identifier (e.g., LoginController, OrderListPage). Used in /migrate <id> and notes paths."
        },
        "kind": {
          "enum": ["page", "controller", "component", "module", "service", "endpoint", "shared"]
        },
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "target_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Other unit ids (or __auth__) that must be migrated first."
        },
        "phase": { "type": "integer", "minimum": 1 },
        "effort": { "enum": ["S", "M", "L", "XL"] },
        "status": {
          "enum": ["pending", "in_progress", "migrated", "verified", "blocked", "skipped", "failed"]
        },
        "history": {
          "type": "array",
          "items": { "$ref": "#/$defs/history_entry" }
        },
        "in_flight": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/in_flight" }
          ]
        },
        "notes_path": { "type": "string" },
        "verification": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "lint": { "type": "string" },
            "typecheck": { "type": "string" },
            "tests": { "type": "string" },
            "verified_at": { "type": "string", "format": "date-time" }
          }
        },
        "failure": {
          "type": "object",
          "properties": {
            "diagnostic": { "type": "string" },
            "branch": { "type": "string" },
            "diagnostic_history": {
              "type": "array",
              "description": "Append-only log of every failure diagnostic this unit has seen. Each /retry pushes the current diagnostic here before overwriting failure.diagnostic with the new one.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["at", "diagnostic"],
                "properties": {
                  "at": { "type": "string", "format": "date-time" },
                  "diagnostic": { "type": "string" },
                  "retry_count": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of times this unit has been retried after a previous failure. Bumped by /web-modernize:retry."
        },
        "last_retry_prompt": {
          "oneOf": [
            { "type": "null" },
            { "type": "string" }
          ],
          "description": "The most recent --with-prompt override passed to /web-modernize:retry, or null if never retried with a prompt."
        },
        "rollback_info": {
          "description": "Populated by /web-modernize:rollback when a unit is rolled back. Null if never rolled back.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["at", "by"],
              "properties": {
                "at": { "type": "string", "format": "date-time" },
                "by": { "type": "string" },
                "branch": { "type": "string", "description": "The feature branch that was reset/removed, if any." },
                "restored_paths": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Target files that were reverted (deleted, or restored to pre-migration state)."
                },
                "reason": { "type": "string" }
              }
            }
          ]
        }
      }
    },
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "by", "from", "to"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "by": { "type": "string", "description": "User identity (email when available)." },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "session_id": { "type": "string" }
      }
    },
    "in_flight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "by", "last_heartbeat"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "by": { "type": "string" },
        "host": { "type": "string" },
        "session_id": { "type": "string" },
        "last_heartbeat": { "type": "string", "format": "date-time" },
        "current_step": { "type": "string" },
        "files_touched_so_far": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
