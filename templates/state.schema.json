{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/balaji-hari/web-mordernize/templates/state.schema.json",
  "title": "web-modernize migration state (top-level)",
  "description": "Schema for .claude/modernize/state.json — the top-level workflow ledger. Per-unit state lives in .claude/modernize/units/<id>.json (see unit.schema.json).",
  "type": "object",
  "required": ["schema_version", "plugin_version", "status", "unit_ids"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "description": "Increment when the top-level state shape changes. The plugin does not migrate forward — a schema_version mismatch requires deleting .claude/modernize/ and running /web-modernize:init.",
      "const": 3
    },
    "plugin_version": {
      "description": "Version of the web-modernize plugin that last wrote this file.",
      "type": "string"
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remote": { "type": "string" },
        "root_commit": { "type": "string" }
      }
    },
    "status": {
      "description": "Top-level workflow phase. Drives which skill is eligible to run next.",
      "enum": [
        "uninitialized",
        "initialized",
        "analyzed",
        "planned",
        "scaffolded",
        "auth_done",
        "in_progress",
        "complete"
      ]
    },
    "source_stack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "detected_at": { "type": "string", "format": "date-time" },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "confidence": { "type": "number" }
            }
          }
        }
      }
    },
    "target_stack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui": { "type": "string", "description": "e.g. react-vite-ts, next-app-router, vue3-vite, angular, svelte-kit" },
        "api": { "type": "string", "description": "e.g. dotnet-minimal-api, spring-boot-3, nestjs, fastapi, reuse-existing, none" },
        "db": { "type": "string", "description": "e.g. unchanged, schema-migrate-to-postgres, replatform-to-mongodb" }
      }
    },
    "strategy": {
      "enum": ["strangler-fig", "big-bang", "module-by-module"]
    },
    "scaffold": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui": { "$ref": "#/$defs/subsystem" },
        "api": { "$ref": "#/$defs/subsystem" },
        "db": { "$ref": "#/$defs/subsystem" }
      }
    },
    "unit_ids": {
      "description": "Ordered list of migration unit ids. Each id corresponds to .claude/modernize/units/<id>.json. The order defines the canonical plan ordering used by /web-modernize:next.",
      "type": "array",
      "items": { "type": "string" }
    },
    "out_of_scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lock": {
      "description": "Advisory lock for full-repo operations (plan, scaffold). null when no lock held.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["holder", "session_id", "expires_at"],
          "additionalProperties": false,
          "properties": {
            "holder": { "type": "string" },
            "session_id": { "type": "string" },
            "expires_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "subsystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["pending", "in_progress", "done", "skipped", "failed"] },
        "path": { "type": "string" },
        "reason": { "type": "string", "description": "Required when status == skipped." },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "completed_by": { "type": "string" }
      },
      "required": ["status"]
    }
  }
}
